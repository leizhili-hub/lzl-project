@@ -435,6 +449,77 @@ export default {
       }
       return map[stage] || { label: '阶段' + stage, type: 'info' }
     },
+    /**
+     * 解析「需重跑」的真实原因（2026-11-06）。
+     *
+     * 后端只在两种情况下写 stage_status=needs_rerun：
+     *   ① 画布产物被人工编辑 → rerun_stages 为下游阶段（摘要/澄清变更=[3,4]，测试点变更=[4]）
+     *   ② 画布级回退 → rerun_stages 为 [N, N+1, N+2, N+3] 连续四段
+     * 这里把阶段号翻译成「因为什么、要重跑哪一步」，避免用户只看到三个字「需重跑」。
+     */
+    rerunInfo(p) {
+      const stages = this.parseArr(p && p.rerun_stages)
+        .map(Number).filter(n => n > 0).sort((a, b) => a - b)
+      const stageNames = { 1: '读取', 2: '结构化', 3: '澄清', 4: '用例' }
+      if (!stages.length) {
+        return { reason: '上游产物变更，下游内容基于旧内容，建议重跑', action: 'design', stages }
+      }
+      // 回退特征：连续四个阶段
+      const isRollback = stages.length === 4
+        && stages.every((s, i) => i === 0 || s === stages[i - 1] + 1)
+      if (isRollback) {
+        const from = stages[0]
+        return {
+          reason: `手动回退到「${stageNames[from] || ('阶段' + from)}」，该画布需重新跑到用例`,
+          action: this.actionOfStage(from),
+          stages,
+        }
+      }
+      if (stages.includes(3)) {
+        return {
+          reason: '摘要或澄清已修改，测试点与冒烟基于旧内容，需重跑测试设计',
+          action: 'design',
+          stages,
+        }
+      }
+      if (stages.includes(4)) {
+        return {
+          reason: '测试点已修改，冒烟基于旧内容，需重新生成用例/冒烟',
+          action: 'generate-cases',
+          stages,
+        }
+      }
+      return {
+        reason: '上游产物变更，下游内容基于旧内容，建议重跑',
+        action: this.actionOfStage(stages[0]),
+        stages,
+      }
+    },
+    actionOfStage(stage) {
+      return ({ 1: 'struct', 2: 'clarify', 3: 'design', 4: 'generate-cases' })[Number(stage)] || 'design'
+    },
+    /** 一键重跑「需重跑」画布：按最小失效阶段选对应动作，跑完后端会自动清掉标记 */
+    async rerunCanvas(p) {
+      const info = this.rerunInfo(p)
+      const actionLabel = {
+        struct: '结构化', clarify: '澄清', design: '测试设计', 'generate-cases': '生成用例/冒烟',
+      }[info.action] || info.action
+      try {
+        await this.$confirm(
+          `将重跑画布「${this.canvasLabel(p)}」的【${actionLabel}】阶段。\n\n` +
+          `原因：${info.reason}\n\n` +
+          '重跑会按当前最新内容重新生成该阶段产物（覆盖旧结果），是否继续？',
+          '重跑确认',
+          { type: 'warning', confirmButtonText: '开始重跑', cancelButtonText: '取消' }
+        )
+      } catch (e) {
+        return
+      }
+      const ok = await this.runCanvasStage(info.action, p)
+      if (ok) {
+        this.$message.success(`已提交【${actionLabel}】重跑，完成后「需重跑」标记会自动消失`)
+      }
+    },
     parseArr(s) {
       if (!s) return []
       try {
@@ -788,6 +873,16 @@ export default {
     .page-name { font-weight: 600; font-size: 14px; }
     .card-progress { margin: 10px 0 6px; }
     .card-meta { font-size: 12px; color: #909399; }
+    .card-rerun {
+      font-size: 12px;
