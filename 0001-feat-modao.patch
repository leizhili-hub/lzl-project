diff --git a/apps/requirement_analysis/models.py b/apps/requirement_analysis/models.py
index 5d34b65..240ba60 100644
--- a/apps/requirement_analysis/models.py
+++ b/apps/requirement_analysis/models.py
@@ -800,9 +800,23 @@ class ModaoPage(models.Model):
         self.rerun_stages = json.dumps(sorted(set(int(s) for s in stages)), ensure_ascii=False)
 
     def mark_stage(self, stage, status='done', log=None, error=None):
-        """统一推进画布级进度。"""
+        """统一推进画布级进度。
+
+        2026-11-06：重跑成功后按阶段清理 rerun_stages（只清 <= stage 的部分），
+        避免「已经重跑过，提示却一直挂着」以及阶段号越累越多。
+        若清理后仍有更高阶段待重跑，则状态继续保持 needs_rerun，
+        让看板标签与真实待办一致（例如重跑测试点后，冒烟仍需重跑）。
+        """
         self.current_stage = max(self.current_stage, stage)
         self.stage_status = status
+        if status == 'done':
+            # 只保留「比本次阶段更高、且真实存在」的待重跑阶段。
+            # 回退接口会写入 [N, N+1, N+2, N+3]（N=4 时出现 5/6/7），
+            # 这些越界阶段永远不会被跑到，必须按 1..4 封顶，否则标记清不掉。
+            pending = sorted(s for s in self.get_rerun_stages() if stage < int(s) <= 4)
+            self.set_rerun_stages(pending)
+            if pending:
+                self.stage_status = 'needs_rerun'
         if log:
             ts = timezone.now().strftime('%Y-%m-%d %H:%M:%S')
             self.work_log = (self.work_log or '') + f'[{ts}] {log}\n'
